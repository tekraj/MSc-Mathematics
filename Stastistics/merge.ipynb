   "source": [
    "import pandas as pd\n",
    "import glob\n",
    "\n",
    "files = glob.glob(\"./data/nepsealpha_export_price_*.csv\")\n",
    "df = pd.concat([pd.read_csv(f) for f in files], ignore_index=True)\n",
    "df.to_csv(\"data/nepse.csv\", index=False)\n",
    "print(f\"Merged {len(files)} files -> {len(df)} rows saved to data/nepse.csv\")\n"
   ]
  }
 ],
