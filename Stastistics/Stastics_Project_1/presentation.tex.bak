\begin{frame}{Autocorrelation Function (ACF)}
\begin{figure}
\centering
\includegraphics[width=0.8\textwidth]{figures/stats-acf.png}
\caption{ACF of daily returns by sector. First lag is significantly positive.}
\end{figure}
\begin{itemize}
    \item Positive lag-1 autocorrelation → momentum effect.
    \item Justifies inclusion of lagged returns in regression.
\end{itemize}
\end{frame}

\begin{frame}{Month and Sector Effects – Statistical Tests}
\begin{itemize}
    \item \textbf{Chi-square test:} Return direction (Gain/Loss) vs month: \(\chi^2(11)=92.58\), \(p=5.2\times10^{-15}\) → strong dependence.
    \item \textbf{One-way ANOVA (month):} \(F=10.46\), \(p<2\times10^{-16}\) → significant monthly differences.
    \item \textbf{One-way ANOVA (sector):} \(F=0.497\), \(p=0.779\) → no significant sector differences.
    \item \textbf{Kruskal–Wallis (sector):} \(H=14.798\), \(p=0.0113\) → weak sector effect.
    \item \textbf{Mann–Whitney (Banking vs Others):} \(p=0.8648\) → no difference.
\end{itemize}
\end{frame}

