\end{figure}
\begin{itemize}
    \item July (Shrawan) shows highest returns across sectors.
    \item August–September consistently negative.
\end{itemize}
\end{frame}

\begin{frame}{Additional EDA – Density, Heatmap, ACF}
\begin{columns}
\column{0.5\textwidth}
\includegraphics[width=\textwidth]{figures/stats-density.png}
\caption{Density with normal reference (dotted red)}
