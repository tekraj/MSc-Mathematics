% ------------------- SECTION: Introduction -------------------
\section{Introduction}

\begin{frame}{Introduction}
\begin{itemize}
    \item The Nepal Stock Exchange (NEPSE) often exhibits patterns influenced by the Bikram Sambat calendar, fiscal year cycles, and major cultural festivals.
    \item This project explores the \textit{Seasonality Hypothesis} — stock returns are not purely random but follow periodic trends that challenge weak-form market efficiency.
    \item By analysing sectoral performance over five years (2021–2026), we aim to distinguish genuine anomalies from noise.
    \item Different sub-sectors (banking, hydropower) show unique trends tied to fiscal year closings and festive windows \cite{gurung2024}.
\end{itemize}
\end{frame}

\begin{frame}{Research Context}
\begin{itemize}
    \item Stock markets often display recurring patterns influenced by economic cycles and investor behaviour.
    \item In NEPSE, sectors exhibit unique trends specifically linked to:
    \begin{itemize}
        \item Fiscal year closings (e.g., Asadh).
        \item Major festivals like Dashain and Tihar.
    \end{itemize}
    \item This study provides a data-driven roadmap for investors to improve trading decisions by identifying optimal entry and exit windows.
\end{itemize}
\end{frame}

% ------------------- SECTION: Objectives -------------------
\section{Objectives}

\begin{frame}{Objectives}
\begin{enumerate}
    \item Identify statistically significant monthly/seasonal trends within NEPSE sub-sectors.
    \item Quantify risk-return profiles of sectors (Banking, Hydropower, Insurance) during high-volatility periods.
    \item Develop a \textit{Z-score} based entry–exit framework for optimising trading timing.
\end{enumerate}
\end{frame}

% ------------------- SECTION: Data Source -------------------
\section{Data Source}

\begin{frame}{Data Source}
\begin{itemize}
    \item \textbf{Period:} 2021 – 2026 (daily closing prices).
    \item \textbf{Source:} Nepse Alpha (\url{https://nepsealpha.com/nepse-data}).
    \item \textbf{Sectors covered:}
    \begin{itemize}
        \item Banking
        \item Hydropower
        \item Manufacturing
        \item Microfinance
        \item Non-Life Insurance
        \item Others
    \end{itemize}
    \item Daily returns are computed as:
    \[
    R_t = \frac{P_t^{\text{close}} - P_{t-1}^{\text{close}}}{P_{t-1}^{\text{close}}}.
    \]
\end{itemize}
\end{frame}

% ------------------- SECTION: Methodology -------------------
\section{Methodology}

\begin{frame}{Methodology Overview}
\begin{itemize}
    \item \textbf{Exploratory Analysis:} Boxplots, histograms, Q–Q plots to assess distribution and outliers.
    \item \textbf{Distribution Analysis:} Skewness, kurtosis, Shapiro–Wilk test.
    \item \textbf{Confirmatory Analysis:} Chi-square, ANOVA, Kruskal–Wallis, Mann–Whitney.
    \item \textbf{Mathematical Modelling:} Simple and multiple linear regression, autoregressive models.
    \item \textbf{Seasonality Detection:}
    \begin{itemize}
        \item Monthly ranking (best/worst months).
        \item Z-score entry/exit framework.
        \item Cumulative return by day-of-year (optimal exit).
        \item Year-on-year consistency.
        \item Bootstrap confidence intervals.
        \item Robust ANOVA (trimmed means) and permutation tests.
        \item Two-way interaction ANOVA (Sector × Month).
    \end{itemize}
\end{itemize}
\end{frame}

