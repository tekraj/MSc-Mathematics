\begin{frame}{Z-Score Entry/Exit Framework}
\begin{table}
\centering
\caption{ENTRY signals for Banking (\(Z < -1.5\))}
\begin{tabular}{lcc}
\toprule
Month & Frequency & Avg Z \\
\midrule
January   & 4 & -2.24 \\
February  & 4 & -2.00 \\
March     & 3 & -1.90 \\
April     & 4 & -1.92 \\
May       & 6 & -2.03 \\
June      & 5 & -1.77 \\
July      & 5 & -1.84 \\
August    & 5 & -2.61 \\
September & 4 & -2.10 \\
October   & 4 & -1.83 \\
\bottomrule
\end{tabular}
\end{table}
\begin{itemize}
    \item Signals occur frequently; average Z ~ -2.0 (two SD below monthly mean).
    \item A conservative threshold of \(\pm 1.8\) is recommended to reduce false signals.
\end{itemize}
\end{frame}

